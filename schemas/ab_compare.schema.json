{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ab_compare.schema.json",
  "type": "object",
  "required": ["metadata", "dataset", "signal_coverage", "comparison"],
  "properties": {
    "report_type": {"type": "string"},
    "report_format_version": {"type": "integer"},
    "report_family": {"type": "string"},
    "generated_at_utc": {"type": "string"},
    "context": {
      "type": "object",
      "properties": {
        "dataset_id": {"type": "string"},
        "engine_id": {"type": "string"},
        "preset_path": {"type": "string"},
        "engine_path": {"type": "string"},
        "base_engine_path": {"type": "string"}
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": ["version", "engine_a_path", "engine_b_path", "config_a", "config_b"],
      "properties": {
        "version": {"type": "string"},
        "engine_a_path": {"type": "string"},
        "engine_b_path": {"type": "string"},
        "config_a": {"type": "object"},
        "config_b": {"type": "object"}
      },
      "additionalProperties": true
    },
    "dataset": {"type": "object"},
    "signal_coverage": {"type": "object"},
    "signal_evidence": {"type": "object"},
    "comparison": {
      "type": "object",
      "required": ["labels", "a", "b", "delta_a_to_b", "outcome", "note"],
      "properties": {
        "labels": {"type": "object"},
        "a": {"type": "object"},
        "b": {"type": "object"},
        "delta_a_to_b": {"type": "object"},
        "outcome": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

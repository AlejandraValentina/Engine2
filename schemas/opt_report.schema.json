{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opt_report.schema.json",
  "type": "object",
  "required": [
    "metadata",
    "params_initial",
    "params_best",
    "error_initial",
    "error_best",
    "evals_used",
    "seed",
    "status"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["input_hash", "timestamp", "version", "settings", "coupling_mode"],
      "properties": {
        "input_hash": {"type": "string"},
        "timestamp": {"type": "string"},
        "version": {"type": "string"},
        "settings": {"type": "object"},
        "coupling_mode": {"type": "string"}
      },
      "additionalProperties": true
    },
    "params_initial": {"type": "object"},
    "params_best": {"type": "object"},
    "error_initial": {"type": "number"},
    "error_best": {"type": "number"},
    "evals_used": {"type": "integer"},
    "seed": {"type": "integer"},
    "status": {"type": "string"}
  },
  "additionalProperties": true
}

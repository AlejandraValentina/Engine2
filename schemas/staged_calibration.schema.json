{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "staged_calibration.schema.json",
  "type": "object",
  "required": ["metadata", "preset_base_path", "dataset", "stages", "final_params", "artifacts"],
  "properties": {
    "report_type": {"type": "string"},
    "report_format_version": {"type": "integer"},
    "report_family": {"type": "string"},
    "generated_at_utc": {"type": "string"},
    "context": {
      "type": "object",
      "properties": {
        "dataset_id": {"type": "string"},
        "engine_id": {"type": "string"},
        "preset_path": {"type": "string"},
        "engine_path": {"type": "string"},
        "base_engine_path": {"type": "string"}
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "required": ["input_hash", "timestamp", "version", "settings", "coupling_mode"],
      "properties": {
        "input_hash": {"type": "string"},
        "timestamp": {"type": "string"},
        "version": {"type": "string"},
        "settings": {"type": "object"},
        "coupling_mode": {"type": "string"}
      },
      "additionalProperties": true
    },
    "preset_base_path": {"type": "string"},
    "dataset": {"type": "object"},
    "signal_evidence": {"type": "object"},
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage_name", "params_touched", "signals_used", "before_metrics", "after_metrics", "accepted", "notes"],
        "properties": {
          "stage_name": {"type": "string"},
          "params_touched": {"type": "array", "items": {"type": "string"}},
          "signals_used": {"type": "array", "items": {"type": "string"}},
          "before_metrics": {"type": "object"},
          "after_metrics": {"type": "object"},
          "accepted": {"type": "boolean"},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "final_params": {"type": "object"},
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "confidence", "signals_used", "metrics_used", "rationale", "suggested_interpretation"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"type": "string"},
          "confidence": {"type": "string"},
          "signals_used": {"type": "array", "items": {"type": "string"}},
          "metrics_used": {"type": "object"},
          "rationale": {"type": "string"},
          "suggested_interpretation": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["calibrated_engine", "benchmark_before", "benchmark_after"],
      "properties": {
        "calibrated_engine": {"type": "string"},
        "benchmark_before": {"type": "string"},
        "benchmark_after": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

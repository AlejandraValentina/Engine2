{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map.schema.json",
  "type": "object",
  "required": ["metadata", "grid", "points"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["input_hash", "timestamp", "version", "settings", "coupling_mode"],
      "properties": {
        "input_hash": {"type": "string"},
        "timestamp": {"type": "string"},
        "version": {"type": "string"},
        "settings": {"type": "object"},
        "coupling_mode": {"type": "string"}
      },
      "additionalProperties": true
    },
    "grid": {
      "type": "object",
      "required": ["rpm", "throttle"],
      "properties": {
        "rpm": {"type": "array", "items": {"type": "number"}},
        "throttle": {"type": "array", "items": {"type": "number"}}
      },
      "additionalProperties": true
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rpm", "throttle", "torque_nm", "power_hp", "bmep_bar", "ve_actual", "map_est_kpa"],
        "properties": {
          "rpm": {"type": "number"},
          "throttle": {"type": "number"},
          "torque_nm": {"type": "number"},
          "power_hp": {"type": "number"},
          "bmep_bar": {"type": "number"},
          "ve_actual": {"type": "number"},
          "map_est_kpa": {"type": ["number", "null"]},
          "fuel_gps": {"type": "number"},
          "bsfc_gpkwh": {"type": "number"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
